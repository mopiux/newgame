extends Node
## Builds SpriteFrames from the sheets generated by tools/art/build_art.py.
## assets/gfx/sprites.json describes frame size, origin and animations.

const GFX_DIR := "res://assets/gfx/"

var _meta: Dictionary = {}
var _frames: Dictionary = {}
var _glow: Dictionary = {}
var _textures: Dictionary = {}


func _ready() -> void:
	var path := GFX_DIR + "sprites.json"
	if not FileAccess.file_exists(path):
		push_error("SpriteLib: missing " + path + " (run tools/art/build_art.py)")
		return
	var data = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(data) != TYPE_DICTIONARY:
		push_error("SpriteLib: invalid sprites.json")
		return
	_meta = data


func has_sheet(sheet: String) -> bool:
	return _meta.has(sheet)


func texture(image_name: String) -> Texture2D:
	if _textures.has(image_name):
		return _textures[image_name]
	var path := GFX_DIR + image_name + ".png"
	var tex: Texture2D = load(path) if ResourceLoader.exists(path) else null
	if tex == null:
		push_error("SpriteLib: missing texture " + path)
	_textures[image_name] = tex
	return tex


func origin(sheet: String) -> Vector2:
	var m: Dictionary = _meta.get(sheet, {})
	var o: Array = m.get("origin", [0, 0])
	return Vector2(o[0], o[1])


func frame_size(sheet: String) -> Vector2:
	var m: Dictionary = _meta.get(sheet, {})
	return Vector2(m.get("frame_w", 16), m.get("frame_h", 16))


func frames(sheet: String) -> SpriteFrames:
	if not _frames.has(sheet):
		_frames[sheet] = _build(sheet, false)
	return _frames[sheet]


func glow_frames(sheet: String) -> SpriteFrames:
	if not _glow.has(sheet):
		_glow[sheet] = _build(sheet, true)
	return _glow[sheet]


func _build(sheet: String, glow: bool) -> SpriteFrames:
	if not _meta.has(sheet):
		push_error("SpriteLib: unknown sheet " + sheet)
		return null
	var m: Dictionary = _meta[sheet]
	var file: String = m.get("glow", "") if glow else m.file
	if file == "":
		return null
	var tex: Texture2D = load(GFX_DIR + file)
	if tex == null:
		push_error("SpriteLib: cannot load " + file)
		return null
	var sf := SpriteFrames.new()
	sf.remove_animation("default")
	var fw: int = m.frame_w
	var fh: int = m.frame_h
	var cols: int = m.columns
	for anim_name in m.anims:
		var a: Dictionary = m.anims[anim_name]
		sf.add_animation(anim_name)
		sf.set_animation_speed(anim_name, a.get("fps", 8.0))
		sf.set_animation_loop(anim_name, a.get("loop", true))
		for idx in a.frames:
			var at := AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2((int(idx) % cols) * fw, (int(idx) / cols) * fh, fw, fh)
			sf.add_frame(anim_name, at)
	return sf


## Creates an AnimatedSprite2D whose sheet origin sits on the node position.
## When the sheet has emissive pixels, a glow child is added that renders
## above the darkness layer and mirrors animation/flip of the parent.
func make_sprite(sheet: String, anim: String = "") -> AnimatedSprite2D:
	var spr := AnimatedSprite2D.new()
	spr.sprite_frames = frames(sheet)
	spr.centered = false
	spr.offset = -origin(sheet)
	if anim != "" and spr.sprite_frames and spr.sprite_frames.has_animation(anim):
		spr.play(anim)
	elif spr.sprite_frames:
		var names := spr.sprite_frames.get_animation_names()
		if names.size() > 0:
			spr.play(names[0])
	var gf: SpriteFrames = glow_frames(sheet) if str(_meta.get(sheet, {}).get("glow", "")) != "" else null
	if gf:
		var g := GlowMirror.new()
		g.sprite_frames = gf
		g.centered = false
		g.offset = spr.offset
		g.name = "Glow"
		spr.add_child(g)
	return spr


## Glow companion: copies animation state from its parent every frame.
class GlowMirror extends AnimatedSprite2D:
	func _ready() -> void:
		# drawn above the darkness overlay so eyes and flames read in the dark
		z_as_relative = false
		z_index = Layers.Z_EMISSIVE

	func _process(_delta: float) -> void:
		var p := get_parent() as AnimatedSprite2D
		if p == null:
			return
		if animation != p.animation and sprite_frames.has_animation(p.animation):
			animation = p.animation
		frame = p.frame
		flip_h = p.flip_h
		flip_v = p.flip_v
		visible = p.visible
