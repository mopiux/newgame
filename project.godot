; Engine configuration file.
; Lumbre - Godot 4.5 (Compatibility renderer)

config_version=5

[application]

config/name="Lumbre"
config/description="Roguelite de acción: tu llama es tu vida, tu munición y tu luz."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Lumbre"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.039, 0.071, 1)
boot_splash/show_image=false
config/icon="res://assets/gfx/icon.png"

[autoload]

Events="*res://src/autoload/events.gd"
Database="*res://src/autoload/database.gd"
SpriteLib="*res://src/autoload/sprite_lib.gd"
Settings="*res://src/autoload/settings.gd"
SaveManager="*res://src/autoload/save_manager.gd"
Audio="*res://src/autoload/audio.gd"
Lights="*res://src/autoload/lights.gd"
Game="*res://src/autoload/game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.es.translation", "res://i18n/strings.en.translation")
locale/fallback="es"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_shots"
2d_physics/layer_5="enemy_shots"
2d_physics/layer_6="pickups"
2d_physics/layer_7="props"

[physics]

2d/default_gravity=0.0
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.043, 0.039, 0.071, 1)
